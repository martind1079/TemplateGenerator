                              },
                              {
                                "Value": "Fair",
                                "Content": "Fair"
                              },
                              {
                                "Value": "Poor",
                                "Content": "Poor"
                              }
                            ]
                          }
                        },
                        {
                          "SingleSelection": {
                            "fieldType": "SingleSelection",
                            "id": 18,
                            "width": 420,
                            "elementName": "WindowsCondition",
                            "name": "Condition.PropertyCondition.WindowsCondition",
                            "title": "Windows",
                            "options": [
                              {
                                "Value": "Good",
                                "Content": "Good"
                              },
                              {
                                "Value": "Fair",
                                "Content": "Fair"
                              },
                              {
                                "Value": "Poor",
                                "Content": "Poor"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "Group": {
                      "fieldType": "Group",
                      "id": 19,
                      "width": 460,
                      "elementName": "Interior",
                      "name": "Condition.PropertyCondition.Interior",
                      "title": "Interior",
                      "children": [
                        {
                          "SingleSelection": {
                            "fieldType": "SingleSelection",
                            "id": 20,
                            "width": 420,
                            "elementName": "DampPresent",
                            "name": "Condition.PropertyCondition.DampPresent",
                            "title": "Signs of damp",
                            "options": [
                              {
                                "Value": "None",
                                "Content": "None"
                              },
                              {
                                "Value": "Some",
                                "Content": "Some"
                              },
                              {
                                "Value": "Extensive",
                                "Content": "Extensive"
                              }
                            ]
                          }
                        },
                        {
                          "Checkbox": {
                            "fieldType": "Checkbox",
                            "id": 21,
                            "width": 420,
                            "elementName": "HeatingWorks",
                            "name": "Condition.PropertyCondition.HeatingWorks",
                            "title": "Heating appears to work"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "ParagraphText": {
                      "fieldType": "ParagraphText",
                      "id": 22,
                      "width": 940,
                      "elementName": "ConditionNotes",
                      "name": "Condition.PropertyCondition.ConditionNotes",
                      "title": "Notes",
                      "textLines": 4
                    }
                  }
                ]
              }
            },
            {
              "Section": {
                "fieldType": "Section",
                "id": 23,
                "width": 940,
                "elementName": "Photographs",
                "name": "Condition.Photographs",
                "title": "Photographs",
                "children": [
                  {
                    "Photo": {
                      "fieldType": "Photo",
                      "id": 24,
                      "width": 460,
                      "elementName": "FrontElevation",
                      "name": "Condition.Photographs.FrontElevation",
                      "title": "Front elevation",
                      "contentHeight": 180
                    }
                  },
                  {
                    "Photo": {
                      "fieldType": "Photo",
                      "id": 25,
                      "width": 460,
                      "elementName": "RearElevation",
                      "name": "Condition.Photographs.RearElevation",
                      "title": "Rear elevation",
                      "contentHeight": 180
                    }
                  }
                ]
              }
            },
            {
              "Section": {
                "fieldType": "Section",
                "id": 26,
                "width": 940,
                "elementName": "Next",
                "name": "Condition.Next",
                "title": "",
                "children": [
                  {
                    "Button": {
                      "fieldType": "Button",
                      "id": 27,
                      "width": 200,
                      "elementName": "ContinueFromCondition",
                      "name": "Condition.Next.ContinueFromCondition",
                      "title": "Continue",
                      "scripts": {
                        "OnTap": "form.changePage(\"Closure\");"
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "Page": {
          "fieldType": "Page",
          "id": 34,
          "width": 980,
          "elementName": "Closure",
          "name": "Closure",
          "title": "Closure",
          "children": [
            {
              "Section": {
                "fieldType": "Section",
                "id": 29,
                "width": 940,
                "elementName": "Completion",
                "name": "Closure.Completion",
                "title": "Completion",
                "children": [
                  {
                    "SingleSelection": {
                      "fieldType": "SingleSelection",
                      "id": 30,
                      "width": 940,
                      "elementName": "Outcome",
                      "name": "Closure.Completion.Outcome",
                      "title": "Visit outcome",
                      "options": [
                        {
                          "Value": "Survey completed",
                          "Content": "Survey completed"
                        },
                        {
                          "Value": "Access refused",
                          "Content": "Access refused"
                        },
                        {
                          "Value": "Property vacant",
                          "Content": "Property vacant"
                        }
                      ]
                    }
                  },
                  {
                    "ParagraphText": {
                      "fieldType": "ParagraphText",
                      "id": 31,
                      "width": 940,
                      "elementName": "Recommendation",
                      "name": "Closure.Completion.Recommendation",
                      "title": "Recommendation",
                      "textLines": 3,
                      "scripts": {
                        "OnValidate": "if this.value == \"\" and Outcome.value == \"Survey completed\" then\n  this.valid = false;\n  this.message = \"A completed survey needs a recommendation.\";\nend"
                      }
                    }
                  },
                  {
                    "Text": {
                      "fieldType": "Text",
                      "id": 32,
                      "width": 940,
                      "elementName": "SignedBy",
                      "name": "Closure.Completion.SignedBy",
                      "title": "Signed by",
                      "scripts": {
                        "OnValidate": "if this.value == \"\" then\n  this.valid = false;\n  this.message = \"The report must be signed.\";\nend"
                      }
                    }
                  },
                  {
                    "Checkbox": {
                      "fieldType": "Checkbox",
                      "id": 33,
                      "width": 620,
                      "elementName": "ReadyToSubmit",
                      "name": "Closure.Completion.ReadyToSubmit",
                      "title": "I confirm this report is complete"
                    }
                  }
                ]
              }
            }
          ]
        }
