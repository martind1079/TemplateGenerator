{
  "Form": {
    "fieldType": "Form",
    "id": 35,
    "width": 980,
    "title": "Property Survey",
    "children": [
      {
        "Page": {
          "fieldType": "Page",
          "id": 14,
          "width": 980,
          "elementName": "Visit",
          "name": "Visit",
          "title": "Visit",
          "children": [
            {
              "Section": {
                "fieldType": "Section",
                "id": 1,
                "width": 940,
                "elementName": "VisitDetails",
                "name": "Visit.VisitDetails",
                "title": "Visit details",
                "children": [
                  {
                    "Text": {
                      "fieldType": "Text",
                      "id": 2,
                      "width": 940,
                      "elementName": "SurveyorName",
                      "name": "Visit.VisitDetails.SurveyorName",
                      "title": "Surveyor name",
                      "scripts": {
                        "OnValidate": "if this.value == \"\" then\n  this.valid = false;\n  this.message = \"The surveyor must be named.\";\nend"
                      }
                    }
                  },
                  {
                    "Text": {
                      "fieldType": "Text",
                      "id": 3,
                      "width": 940,
                      "elementName": "PropertyReference",
                      "name": "Visit.VisitDetails.PropertyReference",
                      "title": "Property reference"
                    }
                  },
                  {
                    "Date": {
                      "fieldType": "Date",
                      "id": 4,
                      "width": 940,
                      "elementName": "VisitDate",
                      "name": "Visit.VisitDetails.VisitDate",
                      "title": "Date of visit"
                    }
                  },
                  {
                    "Time": {
                      "fieldType": "Time",
                      "id": 5,
                      "width": 940,
                      "elementName": "VisitTime",
                      "name": "Visit.VisitDetails.VisitTime",
                      "title": "Time of visit"
                    }
                  },
                  {
                    "Line": {
                      "fieldType": "Line",
                      "id": 6,
                      "width": 940,
                      "elementName": "Divider1",
                      "name": "Visit.VisitDetails.Divider1",
                      "title": ""
                    }
                  },
                  {
                    "Label": {
                      "fieldType": "Label",
                      "id": 7,
                      "width": 940,
                      "elementName": "Guidance",
                      "name": "Visit.VisitDetails.Guidance",
                      "title": "Record what you saw, not what you were told. Photographs carry more weight than notes."
                    }
                  }
                ]
              }
            },
            {
              "Section": {
                "fieldType": "Section",
                "id": 8,
                "width": 940,
                "elementName": "Access",
                "name": "Visit.Access",
                "title": "Access",
                "children": [
                  {
                    "SingleSelection": {
                      "fieldType": "SingleSelection",
                      "id": 9,
                      "width": 940,
                      "elementName": "AccessGained",
                      "name": "Visit.Access.AccessGained",
                      "title": "Was access gained?",
                      "options": [
                        {
                          "Value": "Yes",
                          "Content": "Yes"
                        },
                        {
                          "Value": "No",
                          "Content": "No"
                        }
                      ],
                      "scripts": {
                        "OnValueChange": "if this.value == \"No\" then\n  NoAccessReason.visible = true;\nelse\n  NoAccessReason.visible = false;\nend"
                      }
                    }
                  },
                  {
                    "ParagraphText": {
                      "fieldType": "ParagraphText",
                      "id": 10,
                      "width": 940,
                      "elementName": "NoAccessReason",
                      "name": "Visit.Access.NoAccessReason",
                      "title": "Why was access refused?",
                      "textLines": 3,
                      "hidden": true,
                      "scripts": {
                        "OnValidate": "if this.value == \"\" and NoAccessReason.visible == true then\n  this.valid = false;\n  this.message = \"Say why access could not be gained.\";\nend"
                      }
                    }
                  },
                  {
                    "Checkbox": {
                      "fieldType": "Checkbox",
                      "id": 11,
                      "width": 620,
                      "elementName": "OccupierPresent",
                      "name": "Visit.Access.OccupierPresent",
                      "title": "An occupier was present"
                    }
                  }
                ]
              }
            },
            {
              "Section": {
                "fieldType": "Section",
                "id": 12,
                "width": 940,
                "elementName": "Next",
                "name": "Visit.Next",
                "title": "",
                "children": [
                  {
                    "Button": {
                      "fieldType": "Button",
                      "id": 13,
                      "width": 200,
                      "elementName": "ContinueFromVisit",
                      "name": "Visit.Next.ContinueFromVisit",
                      "title": "Continue",
                      "scripts": {
                        "OnTap": "if AccessGained.value == \"Yes\" then\n  form.changePage(\"Condition\");\nelse\n  form.changePage(\"Closure\");\nend"
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "Page": {
          "fieldType": "Page",
          "id": 28,
          "width": 980,
          "elementName": "Condition",
          "name": "Condition",
          "title": "Condition",
