<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Fixtures are written inline rather than read from the estate. The estate is not in
    the repository and is not on every machine, and a test suite that skips itself when
    it cannot find its input is a test suite nobody notices has stopped running.
  -->

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="2.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FormWorks.Templates/FormWorks.Templates.csproj" />
  </ItemGroup>

</Project>
