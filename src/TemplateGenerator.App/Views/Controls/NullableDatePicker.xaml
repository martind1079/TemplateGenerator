<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="TemplateGenerator.App.Views.Controls.NullableDatePicker"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">

        <Grid>
            <!--  The platform draws this field's edge and its glyph; see Handlers/InputAppearance.  -->
            <DatePicker x:Name="Picker"
                        DateSelected="OnDateSelected"
                        Unfocused="OnPickerUnfocused" />


            <!--
                The empty state: the field is blanked rather than covered on iOS/Mac, so its glyph
                still shows there. WinUI's CalendarDatePicker has no blank state of its own -
                it always renders a real day/month/year - so on Windows this label instead
                paints over it with an opaque background, matching the app's input-box fill.
            -->
            <Label x:Name="PlaceholderLabel"
                   Margin="12,0"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill"
                   VerticalTextAlignment="Center"
                   IsVisible="{Binding IsEmpty, Source={x:Reference Root}}"
                   Style="{StaticResource FormFieldInstruction}"
                   Text="{Binding Placeholder, Source={x:Reference Root}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSetRequested" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!--  Outside the field's border, so it cannot collide with the platform's own glyph.  -->
        <Label Grid.Column="1"
               IsVisible="{Binding HasValue, Source={x:Reference Root}}"
               Style="{StaticResource FormInputAccessory}"
               Text="&#215;"
               VerticalOptions="Center">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnClear" />
            </Label.GestureRecognizers>
        </Label>

    </Grid>

</ContentView>
